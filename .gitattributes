# Normalize line endings. Text files use LF in the repository and in the
# working tree on every platform. This prevents editors/tools on Windows from
# rewriting a file to CRLF (or mixed) endings, which otherwise shows the entire
# file as changed in a diff. Binary files are auto-detected and left untouched.
* text=auto eol=lf

# Explicit binary types (guards against text auto-detection mistakes).
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.vsix binary
*.woff  binary
*.woff2 binary

# Embedded patch and diff subjects preserve the observed whitespace verbatim.
# `git diff --check` should validate the repository file, not reinterpret the
# whitespace carried inside the fixture or example subject.
crates/ripr/examples/*.diff -whitespace
fixtures/**/*.diff -whitespace
fixtures/**/*.patch -whitespace

# These historical Markdown records use two-space hard breaks in compact
# metadata headers. Disable only the end-of-line check for those exact files;
# blank lines at EOF and every other Markdown path remain checked normally.
docs/handoffs/2026-07-11-targeted-rerun-benchmark.md whitespace=-blank-at-eol,blank-at-eof
docs/handoffs/2026-07-12-call-presence-evidence-packet.md whitespace=-blank-at-eol,blank-at-eof
