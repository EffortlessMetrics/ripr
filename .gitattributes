# Normalize line endings. Text files use LF in the repository and in the
# working tree on every platform. This prevents editors/tools on Windows from
# rewriting a file to CRLF (or mixed) endings, which otherwise shows the entire
# file as changed in a diff. Binary files are auto-detected and left untouched.
* text=auto eol=lf

# Explicit binary types (guards against text auto-detection mistakes).
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.vsix binary
*.woff  binary
*.woff2 binary

# A unified diff encodes an empty context line as one space.
# That byte is patch syntax, not source trailing whitespace.
fixtures/*/diff.patch whitespace=-blank-at-eol

# Judged-panel diffs are byte-exact frozen captures bound by recorded digests.
# Trailing whitespace in them is source content and must not be rewritten.
metrics/rust-judged-behavior-panel/diffs/*.diff -whitespace
