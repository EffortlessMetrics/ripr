+    /// still breaks on the first attempt.
+    #[cfg(unix)]
+    const SHIM_PROBE_MAX_LAUNCH_ATTEMPTS: usize = 8;
     #[cfg(unix)]
     fn probe_published_tool_with_command(
         tool: &str,
