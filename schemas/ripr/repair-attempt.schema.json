{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.effortlessmetrics.dev/ripr/repair-attempt.schema.json",
  "title": "RIPR Repair Attempt Manifest",
  "description": "Durable, attempt-specific record spanning the before-phase awaiting-edit boundary and the current after-phase edit-cage verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "repair_attempt_id",
    "state",
    "root",
    "repository_head",
    "producer_version",
    "seam_id",
    "created_unix_ms",
    "artifacts",
    "next_command",
    "limitations",
    "non_claims"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "kind": { "const": "repair_attempt" },
    "repair_attempt_id": {
      "type": "string",
      "pattern": "^repair-attempt-[0-9a-f]{24}$"
    },
    "state": { "enum": ["prepared", "awaiting_edit", "ready_to_finish", "stale", "incomparable", "failed"] },
    "root": { "type": "string", "minLength": 1 },
    "repository_head": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "producer_version": { "type": "string", "minLength": 1 },
    "seam_id": { "type": "string", "minLength": 1 },
    "created_unix_ms": { "type": "integer", "minimum": 0 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "next_command": { "type": "string", "minLength": 1 },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "after": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/after" }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "enum": ["ready_to_finish", "stale", "incomparable", "failed"] } } },
      "then": { "required": ["after"], "properties": { "after": { "$ref": "#/$defs/after" } } }
    },
    {
      "if": { "properties": { "state": { "enum": ["prepared", "awaiting_edit"] } } },
      "then": { "properties": { "after": { "type": "null" } } }
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256", "bytes"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "after": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_id", "repository_head", "delta_sha256", "packet_sha256", "current", "verdict"],
      "properties": {
        "attempt_id": { "type": "string", "pattern": "^repair-attempt-[0-9a-f]{24}$" },
        "repository_head": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "delta_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "packet_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "current": { "type": "boolean" },
        "verdict": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "changed_paths", "violations"],
          "properties": {
            "status": { "enum": ["compliant", "violated", "incomparable"] },
            "changed_paths": { "type": "array", "items": { "type": "string" } },
            "violations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "path", "reason"],
                "properties": {
                  "kind": { "type": "string" },
                  "path": { "type": "string" },
                  "reason": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
