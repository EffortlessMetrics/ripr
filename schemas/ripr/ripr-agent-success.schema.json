{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.effortlessmetrics.dev/ripr/ripr-agent-success.schema.json",
  "title": "RIPR riprAgent success envelope",
  "description": "Bounded producer-owned success fields for a future implemented riprAgent request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "schema_version",
    "request",
    "kind",
    "status",
    "snapshot_id",
    "input_identity",
    "root_identity",
    "config_identity",
    "base_identity",
    "freshness",
    "run_status",
    "profile",
    "budget_identity",
    "selected_count",
    "omitted_count",
    "total_count",
    "complete_evidence_identity",
    "continuation_identity",
    "allowed_edit_surface",
    "must_not_change",
    "verify_route",
    "receipt_route",
    "verify_route_readiness",
    "receipt_route_readiness",
    "verify_command_spec",
    "receipt_command_spec",
    "limitations",
    "non_claims"
  ],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "schema_version": { "const": "0.2" },
    "request": { "$ref": "ripr-agent-request.schema.json#/properties/request" },
    "kind": {
      "enum": [
        "workspace_status",
        "analysis_refreshed",
        "actionable_items",
        "repair_packet",
        "evidence_context",
        "top_limitation",
        "receipt_status"
      ]
    },
    "status": { "const": "ok" },
    "snapshot_id": { "type": ["string", "null"], "minLength": 1 },
    "input_identity": { "type": ["string", "null"], "minLength": 1 },
    "root_identity": { "type": ["string", "null"], "minLength": 1 },
    "config_identity": { "type": ["string", "null"], "minLength": 1 },
    "base_identity": { "type": ["string", "null"], "minLength": 1 },
    "freshness": { "enum": ["fresh", "stale", "unknown"] },
    "run_status": { "enum": ["ready", "analysis_in_flight", "stale", "unknown"] },
    "profile": { "type": ["string", "null"], "enum": ["actionable", "full", null] },
    "budget_identity": { "type": ["string", "null"], "minLength": 1 },
    "selected_count": { "type": "integer", "minimum": 0 },
    "omitted_count": { "type": "integer", "minimum": 0 },
    "total_count": { "type": "integer", "minimum": 0 },
    "complete_evidence_identity": { "type": ["string", "null"], "minLength": 1 },
    "continuation_identity": { "type": ["string", "null"], "minLength": 1 },
    "allowed_edit_surface": { "const": "read_only" },
    "must_not_change": {
      "type": "array",
      "items": { "enum": ["source_edits", "workspace_edit", "autonomous_repair"] },
      "uniqueItems": true
    },
    "verify_route": { "type": ["string", "null"], "minLength": 1 },
    "receipt_route": { "type": ["string", "null"], "minLength": 1 },
    "verify_route_readiness": {
      "description": "Closed readiness vocabulary for the verify_route slot (#1617 slice 4). Null exactly when verify_route is null. typed_direct/typed_shell_required require a producer-owned verify_command_spec; legacy_string_only means only the display string exists; manual means the route is described by a validated spec that is not automatically executable. Slot↔spec role matching (verify vs receipt) is beyond cross-field JSON Schema and is enforced by the Rust resolver in crates/ripr/src/lsp/agent_protocol.rs.",
      "enum": [
        "typed_direct",
        "typed_shell_required",
        "manual",
        "legacy_string_only",
        null
      ]
    },
    "receipt_route_readiness": {
      "description": "Closed readiness vocabulary for the receipt_route slot (#1617 slice 4). Null exactly when receipt_route is null. Slot↔spec role matching is enforced by the Rust resolver.",
      "enum": [
        "typed_direct",
        "typed_shell_required",
        "manual",
        "legacy_string_only",
        null
      ]
    },
    "verify_command_spec": {
      "description": "Producer-owned typed verify route carried in full, or null. The definition is reused from the published repair-assurance CommandSpec contract; the role must be `verify` (enforced by the Rust resolver) and the readiness must match execution_mode.",
      "oneOf": [{ "type": "null" }, { "$ref": "repair-assurance.schema.json#/$defs/command_spec" }]
    },
    "receipt_command_spec": {
      "description": "Producer-owned typed receipt route carried in full, or null. The role must be `receipt` (enforced by the Rust resolver) and the readiness must match execution_mode.",
      "oneOf": [{ "type": "null" }, { "$ref": "repair-assurance.schema.json#/$defs/command_spec" }]
    },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "non_claims": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verify_route_readiness": {
            "enum": ["typed_direct", "typed_shell_required", "manual"]
          }
        },
        "required": ["verify_route_readiness"]
      },
      "then": {
        "properties": { "verify_command_spec": { "type": "object" } },
        "required": ["verify_command_spec"]
      }
    },
    {
      "if": {
        "properties": {
          "receipt_route_readiness": {
            "enum": ["typed_direct", "typed_shell_required", "manual"]
          }
        },
        "required": ["receipt_route_readiness"]
      },
      "then": {
        "properties": { "receipt_command_spec": { "type": "object" } },
        "required": ["receipt_command_spec"]
      }
    },
    {
      "if": {
        "properties": { "verify_command_spec": { "type": "object" } },
        "required": ["verify_command_spec"]
      },
      "then": {
        "properties": {
          "verify_route": { "type": "string", "minLength": 1 },
          "verify_route_readiness": {
            "enum": ["typed_direct", "typed_shell_required", "manual"]
          }
        },
        "required": ["verify_route", "verify_route_readiness"]
      }
    },
    {
      "if": {
        "properties": { "receipt_command_spec": { "type": "object" } },
        "required": ["receipt_command_spec"]
      },
      "then": {
        "properties": {
          "receipt_route": { "type": "string", "minLength": 1 },
          "receipt_route_readiness": {
            "enum": ["typed_direct", "typed_shell_required", "manual"]
          }
        },
        "required": ["receipt_route", "receipt_route_readiness"]
      }
    },
    {
      "if": {
        "properties": {
          "verify_command_spec": {
            "type": "object",
            "properties": { "execution_mode": { "const": "direct" } },
            "required": ["execution_mode"]
          }
        },
        "required": ["verify_command_spec"]
      },
      "then": {
        "properties": { "verify_route_readiness": { "const": "typed_direct" } },
        "required": ["verify_route_readiness"]
      }
    },
    {
      "if": {
        "properties": {
          "verify_command_spec": {
            "type": "object",
            "properties": { "execution_mode": { "const": "shell_required" } },
            "required": ["execution_mode"]
          }
        },
        "required": ["verify_command_spec"]
      },
      "then": {
        "properties": { "verify_route_readiness": { "const": "typed_shell_required" } },
        "required": ["verify_route_readiness"]
      }
    },
    {
      "if": {
        "properties": {
          "verify_command_spec": {
            "type": "object",
            "properties": { "execution_mode": { "const": "manual" } },
            "required": ["execution_mode"]
          }
        },
        "required": ["verify_command_spec"]
      },
      "then": {
        "properties": { "verify_route_readiness": { "const": "manual" } },
        "required": ["verify_route_readiness"]
      }
    },
    {
      "if": {
        "properties": {
          "receipt_command_spec": {
            "type": "object",
            "properties": { "execution_mode": { "const": "direct" } },
            "required": ["execution_mode"]
          }
        },
        "required": ["receipt_command_spec"]
      },
      "then": {
        "properties": { "receipt_route_readiness": { "const": "typed_direct" } },
        "required": ["receipt_route_readiness"]
      }
    },
    {
      "if": {
        "properties": {
          "receipt_command_spec": {
            "type": "object",
            "properties": { "execution_mode": { "const": "shell_required" } },
            "required": ["execution_mode"]
          }
        },
        "required": ["receipt_command_spec"]
      },
      "then": {
        "properties": { "receipt_route_readiness": { "const": "typed_shell_required" } },
        "required": ["receipt_route_readiness"]
      }
    },
    {
      "if": {
        "properties": {
          "receipt_command_spec": {
            "type": "object",
            "properties": { "execution_mode": { "const": "manual" } },
            "required": ["execution_mode"]
          }
        },
        "required": ["receipt_command_spec"]
      },
      "then": {
        "properties": { "receipt_route_readiness": { "const": "manual" } },
        "required": ["receipt_route_readiness"]
      }
    },
    {
      "if": {
        "properties": { "verify_route": { "type": "string" } },
        "required": ["verify_route"]
      },
      "then": {
        "properties": { "verify_route_readiness": { "type": "string" } },
        "required": ["verify_route_readiness"]
      }
    },
    {
      "if": {
        "properties": { "verify_route_readiness": { "type": "string" } },
        "required": ["verify_route_readiness"]
      },
      "then": {
        "properties": { "verify_route": { "type": "string" } },
        "required": ["verify_route"]
      }
    },
    {
      "if": {
        "properties": { "receipt_route": { "type": "string" } },
        "required": ["receipt_route"]
      },
      "then": {
        "properties": { "receipt_route_readiness": { "type": "string" } },
        "required": ["receipt_route_readiness"]
      }
    },
    {
      "if": {
        "properties": { "receipt_route_readiness": { "type": "string" } },
        "required": ["receipt_route_readiness"]
      },
      "then": {
        "properties": { "receipt_route": { "type": "string" } },
        "required": ["receipt_route"]
      }
    }
  ]
}
