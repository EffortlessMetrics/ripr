{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.effortlessmetrics.dev/ripr/ripr-agent-capability.schema.json",
  "title": "RIPR riprAgent capability",
  "description": "Versioned, fail-closed capability discovery for generic headless clients. The shape is derived from the live producer (crates/ripr/src/lsp/agent_protocol.rs server_capability): capability vocabularies stay closed, while the implemented surface (supported_requests/supported_profiles) and the boolean progress surfaces describe what a slice may advertise as handlers land.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "schema_version",
    "implementation_state",
    "supported_requests",
    "reserved_requests",
    "supported_profiles",
    "reserved_profiles",
    "diagnostic_modes",
    "snapshot_handles",
    "continuations",
    "work_done_progress",
    "cancellation",
    "source_edit_capability",
    "analysis_status_notification",
    "compatibility_commands",
    "error_kinds",
    "claim_boundary"
  ],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "schema_version": { "const": "0.2" },
    "implementation_state": { "enum": ["capability_only", "implemented"] },
    "supported_requests": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "ripr/workspaceStatus",
          "ripr/refreshAnalysis",
          "ripr/listActionableItems",
          "ripr/getRepairPacket",
          "ripr/getEvidenceContext",
          "ripr/getTopLimitation",
          "ripr/getReceiptStatus"
        ]
      }
    },
    "reserved_requests": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "ripr/workspaceStatus",
          "ripr/refreshAnalysis",
          "ripr/listActionableItems",
          "ripr/getRepairPacket",
          "ripr/getEvidenceContext",
          "ripr/getTopLimitation",
          "ripr/getReceiptStatus"
        ]
      }
    },
    "supported_profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["actionable", "full"] }
    },
    "reserved_profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["actionable", "full"] }
    },
    "diagnostic_modes": {
      "type": "array",
      "const": ["push"]
    },
    "snapshot_handles": { "type": "boolean" },
    "continuations": { "type": "boolean" },
    "work_done_progress": { "type": "boolean" },
    "cancellation": { "type": "boolean" },
    "source_edit_capability": { "const": "none" },
    "analysis_status_notification": { "const": "ripr/analysisStatus" },
    "compatibility_commands": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "error_kinds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "ripr-agent-error.schema.json#/$defs/error_kind" }
    },
    "claim_boundary": { "type": "string", "minLength": 1 }
  }
}
