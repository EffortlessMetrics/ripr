{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.effortlessmetrics.dev/ripr/review-comments.schema.json",
  "title": "RIPR Review Comments",
  "description": "Diff-scoped RIPR review guidance. Only comments[] can feed non-blocking changed-line annotations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "status",
    "root",
    "base",
    "head",
    "mode",
    "rendering_limits",
    "summary",
    "comments",
    "summary_only",
    "suppressed",
    "warnings",
    "limits_note",
    "run_receipt"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "tool": {
      "const": "ripr"
    },
    "status": {
      "enum": [
        "advisory",
        "incomplete",
        "error"
      ]
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "type": "string",
      "minLength": 1
    },
    "head": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "description": "Public RIPR analysis mode label.",
      "enum": [
        "instant",
        "draft",
        "fast",
        "deep",
        "ready"
      ]
    },
    "analysis_scope": {
      "$ref": "#/$defs/analysis_scope"
    },
    "review_input": {
      "$ref": "#/$defs/review_input"
    },
    "analysis_outcome": {
      "$ref": "#/$defs/analysis_outcome_projection"
    },
    "causal_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "coverage"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base_items",
            "head_items",
            "matched_items",
            "ambiguous_items",
            "unknown_items",
            "complete",
            "low_coverage_disclosed"
          ],
          "properties": {
            "base_items": {
              "type": "integer",
              "minimum": 0
            },
            "head_items": {
              "type": "integer",
              "minimum": 0
            },
            "matched_items": {
              "type": "integer",
              "minimum": 0
            },
            "ambiguous_items": {
              "type": "integer",
              "minimum": 0
            },
            "unknown_items": {
              "type": "integer",
              "minimum": 0
            },
            "complete": {
              "type": "boolean"
            },
            "low_coverage_disclosed": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "rendering_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_inline_comments",
        "max_summary_items"
      ],
      "properties": {
        "max_inline_comments": {
          "type": "integer",
          "minimum": 0
        },
        "max_summary_items": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comments",
        "summary_only",
        "suppressed",
        "unchanged_tests"
      ],
      "properties": {
        "comments": {
          "type": "integer",
          "minimum": 0
        },
        "summary_only": {
          "type": "integer",
          "minimum": 0
        },
        "suppressed": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged_tests": {
          "type": "boolean"
        }
      }
    },
    "comments": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/recommendation"
          },
          {
            "type": "object",
            "required": [
              "placement"
            ],
            "properties": {
              "placement": {
                "$ref": "#/$defs/placement"
              }
            }
          }
        ]
      }
    },
    "summary_only": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/recommendation"
          },
          {
            "type": "object",
            "required": [
              "placement",
              "summary_reason"
            ],
            "properties": {
              "placement": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/placement"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "summary_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "suppressed": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/suppressed"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    },
    "limits_note": {
      "type": "string",
      "minLength": 1
    },
    "run_receipt": {
      "$ref": "#/$defs/run_receipt"
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["analysis_outcome"],
        "properties": {
          "analysis_outcome": {
            "properties": {
              "analysis_complete": { "const": true }
            }
          }
        }
      },
      "then": {
        "properties": {
          "status": { "enum": ["advisory", "error"] }
        }
      }
    },
    {
      "if": {
        "required": ["analysis_outcome"],
        "properties": {
          "analysis_outcome": {
            "properties": {
              "analysis_complete": { "const": false }
            }
          }
        }
      },
      "then": {
        "properties": {
          "status": { "enum": ["incomplete", "error"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "incomplete" }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["analysis_outcome"]
      }
    }
  ],
  "$defs": {
    "review_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "findings", "projection_sha256", "reviewed_count"],
      "properties": {
        "schema_version": { "const": "ripr.review_input.v1" },
        "root": { "type": "string", "minLength": 1 },
        "root_identity": { "type": "string", "minLength": 1 },
        "base_sha": { "type": "string", "minLength": 1 },
        "head_sha": { "type": "string", "minLength": 1 },
        "head_tree": { "type": "string", "minLength": 1 },
        "canonical_diff_sha256": { "type": "string", "minLength": 1 },
        "producer_check_sha256": { "type": "string", "minLength": 1 },
        "check_sha256": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "minLength": 1 },
        "analysis_complete": { "type": "boolean" },
        "total_finding_count": { "type": "integer", "minimum": 0 },
        "projected_finding_count": { "type": "integer", "minimum": 0 },
        "reviewed_count": { "type": "integer", "minimum": 0 },
        "projection_limit": { "type": "integer", "minimum": 0 },
        "projection_truncated": { "type": "boolean" },
        "projection_selection_policy": { "type": "string", "minLength": 1 },
        "projection_selection_policy_version": { "type": "string", "minLength": 1 },
        "projection_sha256": { "type": "string", "minLength": 1 },
        "findings": { "type": "array" }
      }
    },
    "analysis_outcome_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_complete",
        "outcome"
      ],
      "properties": {
        "analysis_complete": {
          "type": "boolean"
        },
        "outcome": {
          "$ref": "#/$defs/analysis_outcome"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "analysis_complete": { "const": true }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "properties": {
                  "kind": {
                    "enum": [
                      "no_scope",
                      "no_changed_lines",
                      "no_behavioral_candidates",
                      "complete_no_findings",
                      "complete_with_findings"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "analysis_complete": { "const": false }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "properties": {
                  "kind": {
                    "enum": [
                      "partial_with_limitations",
                      "unsupported_input",
                      "analysis_failed"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "analysis_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "identity",
        "counts",
        "limitations",
        "claim_boundary"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "kind": {
          "enum": [
            "no_scope",
            "no_changed_lines",
            "no_behavioral_candidates",
            "complete_no_findings",
            "complete_with_findings",
            "partial_with_limitations",
            "unsupported_input",
            "analysis_failed"
          ]
        },
        "identity": {
          "$ref": "#/$defs/analysis_identity"
        },
        "counts": {
          "$ref": "#/$defs/analysis_outcome_counts"
        },
        "limitations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/analysis_limitation"
          }
        },
        "claim_boundary": {
          "const": "Static analysis outcome only; no correctness, test-adequacy, runtime-execution, or merge-readiness claim."
        }
      }
    },
    "analysis_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_identity",
        "root_identity",
        "config_identity",
        "base_revision",
        "input_identity",
        "snapshot_identity"
      ],
      "properties": {
        "repository_identity": { "type": ["string", "null"] },
        "root_identity": { "type": ["string", "null"] },
        "config_identity": { "type": ["string", "null"] },
        "base_revision": { "type": ["string", "null"] },
        "input_identity": { "type": ["string", "null"] },
        "snapshot_identity": { "type": ["string", "null"] }
      }
    },
    "analysis_outcome_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed_file_count",
        "changed_line_count",
        "candidate_line_count",
        "probe_count",
        "finding_count"
      ],
      "properties": {
        "changed_file_count": { "type": "integer", "minimum": 0 },
        "changed_line_count": { "type": "integer", "minimum": 0 },
        "candidate_line_count": { "type": "integer", "minimum": 0 },
        "probe_count": { "type": "integer", "minimum": 0 },
        "finding_count": { "type": "integer", "minimum": 0 }
      }
    },
    "analysis_limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "producer_stage",
        "path",
        "affected_items",
        "bounded_detail",
        "recovery"
      ],
      "properties": {
        "kind": {
          "enum": [
            "combined_hunk_unsupported",
            "unresolved_conflict_markers",
            "malformed_diff",
            "diff_scope_oversized",
            "language_adapter_unavailable",
            "language_scope_unsupported",
            "producer_timeout",
            "producer_failure"
          ]
        },
        "producer_stage": {
          "enum": [
            "diff_load",
            "diff_parse",
            "language_adapter",
            "probe_generation",
            "finding_classification",
            "analysis_pipeline"
          ]
        },
        "path": { "type": ["string", "null"] },
        "affected_items": { "type": ["integer", "null"], "minimum": 0 },
        "bounded_detail": { "type": ["string", "null"] },
        "recovery": {
          "$ref": "#/$defs/analysis_recovery"
        }
      }
    },
    "analysis_recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "detail"],
      "properties": {
        "kind": {
          "enum": [
            "narrow_diff",
            "use_two_way_diff",
            "resolve_conflicts",
            "enable_language",
            "increase_configured_limit",
            "retry",
            "inspect_failure"
          ]
        },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "analysis_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "run_status",
        "basis",
        "changed_files",
        "changed_lines",
        "changed_owner_functions",
        "changed_production_files",
        "immediate_caller_files",
        "scoped_production_files",
        "total_rust_files",
        "total_production_files",
        "production_files_considered",
        "classified_seams_considered",
        "downstream_consumable",
        "limitation",
        "repair_route"
      ],
      "properties": {
        "scope": {
          "enum": [
            "diff_scoped_changed_files",
            "working_set",
            "gap_ledger_artifact"
          ]
        },
        "run_status": {
          "enum": [
            "limited_diff_scope",
            "scoped",
            "artifact_scope"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changed_lines": {
          "type": "integer",
          "minimum": 0
        },
        "changed_owner_functions": {
          "type": "integer",
          "minimum": 0
        },
        "changed_production_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "immediate_caller_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scoped_production_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "total_rust_files": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_production_files": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "production_files_considered": {
          "type": "integer",
          "minimum": 0
        },
        "classified_seams_considered": {
          "type": "integer",
          "minimum": 0
        },
        "downstream_consumable": {
          "type": "boolean"
        },
        "limitation": {
          "type": "string",
          "minLength": 1
        },
        "repair_route": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "run_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "root_identity",
        "base_sha",
        "head_sha",
        "requested_mode",
        "analysis_identity",
        "phase_evidence",
        "primary_failure",
        "configured_timeout_ms",
        "last_completed_phase",
        "active_phase",
        "completed_artifacts",
        "missing_artifacts",
        "reusable_cache_identity",
        "limitations",
        "non_claims",
        "atomic_write_status"
      ],
      "properties": {
        "schema_version": {
          "const": "0.2"
        },
        "status": {
          "enum": [
            "in_progress",
            "complete",
            "limited_timeout",
            "failed"
          ]
        },
        "root_identity": {
          "type": "string",
          "minLength": 1
        },
        "base_sha": {
          "type": "string",
          "minLength": 1
        },
        "head_sha": {
          "type": "string",
          "minLength": 1
        },
        "requested_mode": {
          "enum": ["instant", "draft", "fast", "deep", "ready"]
        },
        "analysis_identity": {
          "type": ["object", "null"]
        },
        "phase_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["phase", "duration_ms", "reused", "subject_count", "stop_reason", "input_identity_digest"],
            "properties": {
              "phase": { "type": "string", "minLength": 1 },
              "duration_ms": { "type": "integer", "minimum": 0 },
              "reused": { "type": "boolean" },
              "subject_count": { "type": ["integer", "null"], "minimum": 0 },
              "stop_reason": { "type": "string", "minLength": 1 },
              "input_identity_digest": { "type": ["string", "null"] }
            }
          }
        },
        "primary_failure": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["phase", "category", "message", "secondary_diagnostics"],
          "properties": {
            "phase": { "type": "string", "minLength": 1 },
            "category": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 },
            "secondary_diagnostics": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "configured_timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "last_completed_phase": {
          "type": ["string", "null"]
        },
        "active_phase": {
          "type": ["string", "null"]
        },
        "completed_artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missing_artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reusable_cache_identity": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["category", "repair_route"],
            "properties": {
              "category": {
                "type": "string",
                "minLength": 1
              },
              "repair_route": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "non_claims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "atomic_write_status": {
          "enum": ["not_written", "committed"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "const": "complete" }
            }
          },
          "then": {
            "required": [
              "last_completed_phase",
              "active_phase",
              "completed_artifacts",
              "missing_artifacts"
            ],
            "properties": {
              "last_completed_phase": { "const": "artifact_io" },
              "active_phase": { "type": "null" },
              "completed_artifacts": { "minItems": 1 },
              "missing_artifacts": { "maxItems": 0 },
              "phase_evidence": { "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": { "const": "limited_timeout" }
            }
          },
          "then": {
            "required": ["active_phase", "limitations", "non_claims"],
            "properties": {
              "active_phase": { "type": "string", "minLength": 1 },
              "limitations": { "minItems": 1 },
              "non_claims": { "minItems": 1 },
              "missing_artifacts": { "minItems": 1 },
              "primary_failure": { "type": "object" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": { "const": "failed" }
            }
          },
          "then": {
            "required": ["limitations", "non_claims"],
            "properties": {
              "limitations": { "minItems": 1 },
              "non_claims": { "minItems": 1 },
              "missing_artifacts": { "minItems": 1 },
              "primary_failure": { "type": "object" }
            }
          }
        }
      ]
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "seam_id",
        "canonical_gap_id",
        "dedupe_key",
        "kind",
        "grip_class",
        "severity",
        "owner",
        "seam",
        "source_location",
        "reason",
        "suggested_test",
        "llm_guidance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "seam_id": {
          "type": "string",
          "minLength": 1
        },
        "dedupe_key": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "grip_class": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "seam": {
          "$ref": "#/$defs/seam"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "missing_discriminator": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_location": {
          "$ref": "#/$defs/source_location"
        },
        "suggested_test": {
          "$ref": "#/$defs/suggested_test"
        },
        "llm_guidance": {
          "$ref": "#/$defs/llm_guidance"
        },
        "gap_state": {
          "description": "RIPR actionability state per RIPR-SPEC-0061 / RIPR-SPEC-0068. Present on every card.",
          "type": "string",
          "enum": [
            "actionable",
            "static_limitation",
            "already_observed",
            "internal_only",
            "unknown"
          ]
        },
        "receipt_command": {
          "description": "Copyable ripr agent receipt command. Present when gap_state == actionable.",
          "type": "string",
          "minLength": 1
        },
        "why_not_actionable": {
          "description": "Human-readable sentence from the first static limitation reason. Present when gap_state == static_limitation.",
          "type": "string",
          "minLength": 1
        },
        "non_claims": {
          "description": "Advisory-only boundary declarations. Present when gap_state == static_limitation.",
          "$ref": "#/$defs/non_claims"
        },
        "canonical_gap_id": {
          "description": "Stable canonical gap identity projected from the domain model. Present on working-set and gap-ledger cards; null when the producing domain has no eligible identity.",
          "type": [
            "string",
            "null"
          ]
        },
        "oracle_kind": {
          "description": "Card-level oracle kind (RIPR-SPEC-0068) — the representative related test's oracle, or 'unknown' when no related test observes the seam. Working-set path.",
          "type": "string",
          "enum": [
            "exact_value",
            "exact_error_variant",
            "whole_object_equality",
            "snapshot",
            "relational_check",
            "broad_error",
            "smoke_only",
            "mock_expectation",
            "unknown"
          ]
        },
        "oracle_strength": {
          "description": "Card-level oracle strength (RIPR-SPEC-0068) — the representative related test's oracle strength, or 'none' when no related test observes the seam. Working-set path.",
          "type": "string",
          "enum": [
            "strong",
            "medium",
            "weak",
            "smoke",
            "none",
            "unknown"
          ]
        }
      }
    },
    "seam": {
