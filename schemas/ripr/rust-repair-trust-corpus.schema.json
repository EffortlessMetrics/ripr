{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.effortlessmetrics.dev/ripr/rust-repair-trust-corpus.schema.json",
  "title": "RIPR Rust Repair Trust Corpus",
  "description": "Authorized, receipt-backed Rust repair attempts used to measure route quality. Synthetic and preview cases are not production corpus entries.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "description", "authorization", "cases", "exclusions", "observations"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "kind": { "const": "rust_repair_trust_corpus" },
    "description": { "type": "string", "minLength": 1 },
    "authorization": { "$ref": "#/$defs/authorization" },
    "cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/attempt" }
    },
    "exclusions": {
      "type": "array",
      "items": { "$ref": "#/$defs/exclusion" }
    },
    "observations": {
      "type": "array",
      "items": { "$ref": "#/$defs/observation" }
    }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "string_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "repositories"],
      "properties": {
        "status": { "enum": ["missing", "complete"] },
        "authorization_ref": { "$ref": "#/$defs/non_empty_string" },
        "repositories": {
          "type": "array",
          "items": { "$ref": "#/$defs/repository_authorization" }
        }
      }
    },
    "repository_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "authorization_ref",
        "authorized_revision_or_branch",
        "allowed_artifact_paths",
        "allowed_analysis_actions",
        "write_policy",
        "authorization_date"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/non_empty_string" },
        "authorization_ref": { "$ref": "#/$defs/non_empty_string" },
        "authorized_revision_or_branch": { "$ref": "#/$defs/non_empty_string" },
        "authorized_observation_heads": { "$ref": "#/$defs/string_array" },
        "allowed_artifact_paths": { "$ref": "#/$defs/string_array" },
        "allowed_analysis_actions": { "$ref": "#/$defs/string_array" },
        "write_policy": { "$ref": "#/$defs/non_empty_string" },
        "authorization_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "repository",
        "analyzed_head_sha",
        "canonical_gap_id",
        "seam_id",
        "file_line",
        "changed_behavior",
        "missing_discriminator",
        "related_test_or_production_caller",
        "focused_test_intent",
        "before_receipt",
        "repair_intent",
        "verification_command",
        "verification_result",
        "targeted_rerun_command",
        "receipt_command",
        "inspection_command",
        "after_receipt",
        "claim_boundary",
        "attempt_number",
        "changed_test_files",
        "allowed_edit_surface",
        "limitations",
        "source_refs",
        "movement",
        "test_only",
        "production_files_changed",
        "false_actionability",
        "known_impossible_recommendation",
        "parity_failure",
        "artifact_archaeology"
      ],
      "properties": {
        "attempt_id": { "$ref": "#/$defs/non_empty_string" },
        "repository": { "$ref": "#/$defs/non_empty_string" },
        "analyzed_head_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "canonical_gap_id": {
          "type": "string",
          "pattern": "^gap:.+"
        },
        "seam_id": { "$ref": "#/$defs/non_empty_string" },
        "file_line": { "$ref": "#/$defs/non_empty_string" },
        "changed_behavior": { "$ref": "#/$defs/non_empty_string" },
        "missing_discriminator": { "$ref": "#/$defs/non_empty_string" },
        "related_test_or_production_caller": { "$ref": "#/$defs/non_empty_string" },
        "focused_test_intent": { "$ref": "#/$defs/non_empty_string" },
        "before_receipt": { "$ref": "#/$defs/non_empty_string" },
        "repair_intent": { "$ref": "#/$defs/non_empty_string" },
        "verification_command": { "$ref": "#/$defs/non_empty_string" },
        "verification_result": { "$ref": "#/$defs/non_empty_string" },
        "targeted_rerun_command": { "$ref": "#/$defs/non_empty_string" },
        "receipt_command": { "$ref": "#/$defs/non_empty_string" },
        "inspection_command": { "$ref": "#/$defs/non_empty_string" },
        "after_receipt": { "$ref": "#/$defs/non_empty_string" },
        "claim_boundary": { "$ref": "#/$defs/non_empty_string" },
        "attempt_number": { "type": "integer", "minimum": 1 },
        "changed_test_files": { "$ref": "#/$defs/string_array", "minItems": 1 },
        "allowed_edit_surface": { "$ref": "#/$defs/string_array", "minItems": 1 },
        "limitations": { "$ref": "#/$defs/string_array" },
        "source_refs": { "$ref": "#/$defs/string_array", "minItems": 1 },
        "movement": {
          "enum": ["closed", "improved", "unchanged", "regressed", "limited"]
        },
        "test_only": { "const": true },
        "production_files_changed": { "const": false },
        "false_actionability": { "type": "boolean" },
        "known_impossible_recommendation": { "type": "boolean" },
        "parity_failure": { "type": "boolean" },
        "artifact_archaeology": { "type": "boolean" }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exclusion_id",
        "repository",
        "analyzed_head_sha",
        "source_ref",
        "reason",
        "evidence_ref",
        "command",
        "claim_boundary"
      ],
      "properties": {
        "exclusion_id": { "$ref": "#/$defs/non_empty_string" },
        "repository": { "$ref": "#/$defs/non_empty_string" },
        "canonical_candidate_id": { "$ref": "#/$defs/non_empty_string" },
        "analyzed_head_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "source_ref": { "$ref": "#/$defs/non_empty_string" },
        "reason": {
          "enum": [
            "analysis_timeout",
            "diff_scope_oversized",
            "static_limitation_no_repair_packet",
            "false_actionability",
            "production_test_path_rejected",
            "verification_failed",
            "no_current_behavior_change"
          ]
        },
        "evidence_ref": { "$ref": "#/$defs/non_empty_string" },
        "command": { "$ref": "#/$defs/non_empty_string" },
        "claim_boundary": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "repository",
        "analyzed_head_sha",
        "source_ref",
        "canonical_candidate_id",
        "reason",
        "evidence_ref",
        "classification",
        "claim_boundary"
      ],
      "properties": {
        "observation_id": { "$ref": "#/$defs/non_empty_string" },
        "repository": { "$ref": "#/$defs/non_empty_string" },
        "analyzed_head_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "source_ref": { "$ref": "#/$defs/non_empty_string" },
        "canonical_candidate_id": { "$ref": "#/$defs/non_empty_string" },
        "reason": {
          "enum": [
            "analysis_timeout",
            "diff_scope_oversized",
            "static_limitation_no_repair_packet",
            "false_actionability",
            "production_test_path_rejected",
            "verification_failed",
            "no_current_behavior_change"
          ]
        },
        "evidence_ref": { "$ref": "#/$defs/non_empty_string" },
        "classification": {
          "enum": ["new_exclusion", "duplicate_observation"]
        },
        "duplicate_of": { "$ref": "#/$defs/non_empty_string" },
        "claim_boundary": { "$ref": "#/$defs/non_empty_string" }
      },
      "allOf": [
        {
          "if": { "properties": { "classification": { "const": "duplicate_observation" } } },
          "then": { "required": ["duplicate_of"] }
        }
      ]
    }
  }
}
