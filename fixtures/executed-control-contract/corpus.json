    {
      "description": "Executed removal control fails before and passes after the repair.",
      "id": "fail_before_pass_after",
      "packet": {
        "kind": "executed_control_packet",
        "obligations": [
          {
            "acceptable_evidence_forms": [
              "retained_artifact",
              "bounded_log_commitment"
