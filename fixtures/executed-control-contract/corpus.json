              "command_or_instrument_id": "cargo test -p example -- removed_guard_control",
              "named_wrong_implementation": "eager_file_count_parse",
              "required_head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
