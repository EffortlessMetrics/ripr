            "control_class": "removed_guard",
            "expected_discriminating_outcome": "fails_before_passes_after",
            "intended_wrong_implementation": "eager parse of the lazy tail",
            "invalidators": [
              "source_head_moved",
              "control_contract_changed",
              "artifact_missing",
              "command_identity_changed"
            ],
            "kind": "executed_control_obligation",
