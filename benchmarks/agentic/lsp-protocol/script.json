      "fragments": ["finding_id", "seam_id", "gap_id"]
    },
    {
      "label": "collectContext string first argument",
      "params": { "command": "ripr.collectContext", "arguments": ["not-an-object"] },
      "fragments": ["finding_id", "seam_id", "gap_id"]
    },
    {
      "label": "collectEvidenceContext empty arguments",
      "params": { "command": "ripr.collectEvidenceContext", "arguments": [] },
      "fragments": ["seam_id", "evidence_identity"]
    },
    {
      "label": "collectRepairPacket mistyped gap_id",
      "params": { "command": "ripr.collectRepairPacket", "arguments": [{ "gap_id": 7 }] },
      "fragments": ["gap_id"]
    }
  ],
  "journey_arguments": {
